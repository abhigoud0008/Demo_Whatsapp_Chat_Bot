# ==============================================================================
# GrievanceFlow Environment Variables (Example - NO SECRETS)
# Configure these in Netlify -> Site configuration -> Environment variables.
# Scope all secrets to Functions / Runtime. NEVER prefix with VITE_.
# Frontend builds (npm run build) require ZERO backend secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Target & Server-Side Admin SDK (Netlify Functions)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="grievance-project-3c98a"
FIRESTORE_DATABASE_ID="(default)"
FIREBASE_ENABLE_ADC_FIRESTORE="false"

# Single-line JSON of a dedicated least-privilege service account (roles/datastore.user ONLY).
# Store strictly as a secret in Netlify Environment Variables; never commit to GitHub.
FIREBASE_ADMIN_CREDENTIALS_JSON=""

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Cloud API (Strictly Server-Side - NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ------------------------------------------------------------------------------
# 3. Optional (Only needed for resolutions sent >24h after customer message)
# Leave empty during initial live testing within the 24h customer-service window.
# ------------------------------------------------------------------------------
WHATSAPP_RESOLUTION_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
